# Copy to .env (run.sh does this for you and generates ENCRYPTION_KEY).
DATABASE_PATH=app.db
# The knowledge base has its own database file. Back both files up together.
KNOWLEDGE_DB_PATH=knowledgebase.db
# The raw API log (each REST call made to the model provider during a replay) has its own database file too.
LOG_DB_PATH=Log.db
# Fernet key used to encrypt provider API keys at rest. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Optional: one OpenAI key for the whole server, added by hand. Every account sees it as one more API (read only,
# labelled "OpenAI (server key)") beside the APIs it adds on the Account page. Leave empty for none. Restart after changing it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Model IDs offered with this key (comma-separated; the first is the default). Check what your key can use at /v1/models.
OPENAI_MODELS=gpt-6.1-sol,gpt-6.1-terra,gpt-6-luna,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4,gpt-5.4-mini
LOG_LEVEL=INFO
LLM_TIMEOUT_SECONDS=30
# The most prompts one conversation may hold, and the most one replay runs (1 to 200). A chat that reaches it starts a new conversation.
MAX_USER_PROMPTS=10
# Walk the agent's knowledge base before answering (up to 3 extra model calls per answer).
KB_ROUTING_ENABLED=true
# The most a knowledge base file may hold, in UTF-8 bytes. The whole file is sent to the model.
# KB_MAX_DOCUMENT_BYTES=10240
# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Password of the seeded "demo" account.
DEMO_PASSWORD=demo
# Set true in shared/production deployments: refuse API URLs that resolve to private, loopback or link-local addresses.
BLOCK_PRIVATE_LLM_URLS=false
